DATABASE_URL=postgresql+psycopg://hackcity:hackcity@db:5432/hackcity
DATA_DIR=/data
UPLOADS_DIR=/uploads

# Challenge rule (docs/operations_requirements.md §4) — change here only
ABANDON_MINUTES=120

# Abandonment clock window: only minutes between the two local hours count toward ABANDON_MINUTES
# (a bike parked at 19:30 is abandoned at 09:30 the next day). Switch with `make enforce-window-off`
# / `make enforce-window-on`; that also rebuilds the analysis tables that use the clock.
ENFORCE_WINDOW=true
ENFORCE_FROM_HOUR=8
ENFORCE_UNTIL_HOUR=20
ENFORCE_TZ=Europe/Lisbon
BUFFER_M=30
MOVE_TOLERANCE_M=10
# TO CONFIRM with provider: GPS error assumed when the feed gives none
DEFAULT_LOCATION_ERROR_M=0
# TO CONFIRM: max age of a "fresh" observation that allows dispatch
FRESH_MAX_AGE_MIN=60
# Live feed: every 60 s poll re-observes parked bikes, so the strict rule works in real use.
REQUIRE_FRESH_OBSERVATION=true
# Replay demo: history rarely has a 2nd same-position sighting (7 days -> 1 eligible bike).
REPLAY_REQUIRE_FRESH_OBSERVATION=false
# B1: histogram fits UTC (trough 04 UTC, peak 16-17 UTC) but can't rule out local; MDS convention = UTC. Confirm with data partner.
SOURCE_TZ=UTC

# Complexo Multisserviços da CMC, Estrada de Manique 1830, Alcabideche (source: Câmara Municipal de Cascais)
DEPOT_LAT=38.736686
DEPOT_LNG=-9.386868
# TO CONFIRM: safe bikes per van
VAN_CAPACITY=6
DETOUR_FACTOR=1.3

# Simulated seconds per real second in demo replay
REPLAY_SPEED=360

# Live provider feed (Bird GBFS; feed URLs from datasets/gbfs.json). Public bike_id rotates,
# so parked bikes are tracked by position + type + battery.
LIVE_ENABLED=true
GBFS_INDEX_FILE=/data/gbfs.json
GBFS_POLL_S=60
GBFS_FORM_FACTORS=bicycle
GBFS_GONE_GRACE_S=180
GBFS_STALE_REPORT_MIN=30

# Data analysis (separate PostGIS database)
ANALYTICS_DATABASE_URL=postgresql://analytics:analytics@analytics-db:5432/analytics

# Road routing: OpenStreetMap graph served by OSRM (build once with `make osrm`).
# ROUTING_ENGINE=straight-line disables it; routes then fall back to straight lines, flagged in the app.
ROUTING_ENGINE=osrm
OSRM_URL=http://osrm:5000
