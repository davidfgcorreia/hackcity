DATABASE_URL=postgresql+psycopg://hackcity:hackcity@db:5432/hackcity
DATA_DIR=/data
UPLOADS_DIR=/uploads

# Challenge rule (docs/operations_requirements.md §4) — change here only
ABANDON_MINUTES=120
BUFFER_M=30
MOVE_TOLERANCE_M=10
# TO CONFIRM with provider: GPS error assumed when the feed gives none
DEFAULT_LOCATION_ERROR_M=0
# TO CONFIRM: max age of a "fresh" observation that allows dispatch
FRESH_MAX_AGE_MIN=60
# Real use: true. Demo: false — historical data rarely has a second same-position sighting
# (7 replayed days -> 1 eligible bike). Cases then say "fresh-evidence rule disabled".
REQUIRE_FRESH_OBSERVATION=false
# B1: histogram fits UTC (trough 04 UTC, peak 16-17 UTC) but can't rule out local; MDS convention = UTC. Confirm with data partner.
SOURCE_TZ=UTC

# PLACEHOLDER — set real coordinates of Complexo Multisserviços da CMC
DEPOT_LAT=38.7223
DEPOT_LNG=-9.4205
# TO CONFIRM: safe bikes per van
VAN_CAPACITY=6
DETOUR_FACTOR=1.3

# Simulated seconds per real second in demo replay
REPLAY_SPEED=360
