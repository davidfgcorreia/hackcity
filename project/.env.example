DATABASE_URL=postgresql+psycopg://hackcity:hackcity@db:5432/hackcity
DATA_DIR=/data
UPLOADS_DIR=/uploads

# Challenge rule (docs/operations_requirements.md §4) — change here only
ABANDON_MINUTES=120
BUFFER_M=30
MOVE_TOLERANCE_M=10
# TO CONFIRM with provider: GPS error assumed when the feed gives none
DEFAULT_LOCATION_ERROR_M=0
# TO CONFIRM: max age of a "fresh" observation that allows dispatch
FRESH_MAX_AGE_MIN=60
REQUIRE_FRESH_OBSERVATION=true
# TO VERIFY (T-B1): timezone of naive timestamps in viagens.xlsx
SOURCE_TZ=UTC

# PLACEHOLDER — set real coordinates of Complexo Multisserviços da CMC
DEPOT_LAT=38.7223
DEPOT_LNG=-9.4205
# TO CONFIRM: safe bikes per van
VAN_CAPACITY=6
DETOUR_FACTOR=1.3

# Simulated seconds per real second in demo replay
REPLAY_SPEED=360
